{
  "name": "algoritmo-pessoal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "node scripts/dev-local.mjs --standalone",
    "local": "node scripts/dev-local.mjs --standalone",
    "sync": "node scripts/sync-content.mjs",
    "prebuild": "node scripts/sync-content.mjs",
    "build": "node node_modules/vite/bin/vite.js build --config vite.local.config.ts",
    "build:local": "npm run build",
    "check": "node node_modules/typescript/bin/tsc --noEmit",
    "preview": "node node_modules/vite/bin/vite.js preview --config vite.local.config.ts --host 127.0.0.1 --port 5173",
    "build:vercel": "node scripts/sync-content.mjs --public && node node_modules/vite/bin/vite.js build --config vite.local.config.ts"
  },
  "dependencies": {
    "react": "19.2.6",
    "react-dom": "19.2.6",
    "lucide-react": "^1.31.0"
  },
  "devDependencies": {
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "typescript": "5.9.3",
    "vite": "8.0.13"
  }
}
